# Normalize line endings to LF everywhere
* text=auto eol=lf

# Explicitly LF for source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf

# Binary files - no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.mp4 binary
*.mov binary
*.woff2 binary
*.woff binary
*.ttf binary
